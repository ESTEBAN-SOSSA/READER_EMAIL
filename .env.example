# ===== Microsoft 365 / Azure AD =====
# Crea una App Registration en Azure Portal:
#   1. Azure Portal -> Azure Active Directory -> App registrations -> New registration
#   2. Copia los IDs aqui abajo
#   3. En "Certificates & secrets" crea un Client Secret y copialo
#   4. En "API permissions" agrega (Application type, NO delegated):
#        - Microsoft Graph -> Mail.Read
#        - Microsoft Graph -> Mail.ReadBasic.All (opcional)
#   5. Click "Grant admin consent"
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me

# ===== Configuracion del lector =====
# Buzones a monitorear (separados por coma). Pueden ser UPN o ObjectId
MAILBOXES=cotizaciones@tudominio.com,ventas@tudominio.com

# Cantidad maxima de correos a leer por ejecucion por buzon
MAX_MESSAGES_PER_MAILBOX=50

# Solo correos no leidos (true/false)
UNREAD_ONLY=true

# Solo correos recibidos HOY (true/false). Util para pruebas.
ONLY_TODAY=false

# Carpeta donde guardar adjuntos descargados
ATTACHMENTS_DIR=./attachments

# Base de datos SQLite
DATABASE_PATH=./data/reader_email.db

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== Anthropic API (clasificacion semantica) =====
# Generar en https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Modelo: claude-haiku-4-5 (default) | claude-sonnet-4-6 | claude-opus-4-7
ANTHROPIC_MODEL=claude-haiku-4-5

# Activar clasificacion IA (true) o usar solo reglas determinsticas (false)
USE_CLAUDE_CLASSIFIER=true
